<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Soul Bled Comic Viewer</title>

<style>
  body {
    margin: 0;
    background-color: #0d0d0d;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  #comic-container {
    width: 100%;
    max-width: 1080px;
    aspect-ratio: 9 / 16;       /* Vertical screen ratio */
    position: relative;
    overflow: hidden;
    background-color: #000;
  }

  #comic {
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: pointer;
    user-select: none;
  }

  #hint {
    position: absolute;
    bottom: 10px;
    width: 100%;
    text-align: center;
    color: #ffffff88;
    font-family: sans-serif;
    font-size: 14px;
  }
</style>
</head>

<body>
  <div id="comic-container">
    <img id="comic" src="" alt="Soul Bled Comic">
    <div id="hint">(tap or click to continue)</div>
  </div>

  <script>
    // Add all your panel images here (replace with your real links)
    const images = [
      "https://raw.githubusercontent.com/quaintcy/test-comic/refs/heads/main/page1.png",
      "https://raw.githubusercontent.com/quaintcy/test-comic/refs/heads/main/page2.png",
      "https://raw.githubusercontent.com/quaintcy/test-comic/refs/heads/main/page3.png",
      // ...add more panels here
    ];

    let index = 0;
    const comic = document.getElementById("comic");

    // Load first panel
    comic.src = images[index];

    // Change panel when clicked or tapped
    document.getElementById("comic-container").addEventListener("click", () => {
      index++;
      if (index >= images.length) {
        index = images.length - 1; // stay on last panel
        document.getElementById("hint").textContent = "(end)";
        return;
      }
      comic.src = images[index];
    });

    // Optional: allow going back with arrow keys
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        index = Math.max(0, index - 1);
        comic.src = images[index];
      } else if (e.key === "ArrowRight" || e.key === " ") {
        index = Math.min(images.length - 1, index + 1);
        comic.src = images[index];
      }
    });
  </script>
</body>
</html>
