<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Soul Bled Comic Viewer</title>
  <style>
    body {
      background-color: #0f0f0f;
      color: white;
      text-align: center;
      margin: 0;
      overflow: hidden;
    }
    img {
      width: 390px;
      height: 844px;
      object-fit: contain;
    }
    #comic {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
  </style>
</head>
<body>
  <div id="comic">
    <img id="comicImage" src="page1.png" alt="Soul Bled Comic">
  </div>
  <script>
    const images = [
      "https://raw.githubusercontent.com/quaintcy/test-comic/main/page1.png",
      "https://raw.githubusercontent.com/quaintcy/test-comic/main/page2.png",
      "https://raw.githubusercontent.com/quaintcy/test-comic/main/page3.png"
    ];
    let current = 0;
    const comicImage = document.getElementById("comicImage");

    document.body.addEventListener("click", () => {
      current = (current + 1) % images.length;
      comicImage.src = images[current];
    });
  </script>
</body>
</html>

